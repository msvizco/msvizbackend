{
  "installCommand": "npm install --include=dev",
  "buildCommand": "npm run vercel-build",
  "rewrites": [
    { "source": "/health", "destination": "/api/health" },
    { "source": "/(.*)", "destination": "/api" }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "memory": 1024
    },
    "api/health.ts": {
      "maxDuration": 10,
      "memory": 128
    }
  }
}
