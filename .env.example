PORT=5000
NODE_ENV=development
# Replace USER and PASSWORD with your local Postgres credentials.
# Example: postgresql://postgres:yourpassword@localhost:5432/msviz?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/msviz?schema=public
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=msviz-images
FRONTEND_URL=http://localhost:5173
ADMIN_EMAIL=admin@msviz.com
ADMIN_PASSWORD=Admin@MSVIZ2026
ADMIN_NAME=MSVIZ Admin
MAX_FILE_SIZE_MB=10
