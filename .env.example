PORT=5000
NODE_ENV=development
# Use a pooled connection string in production (Supabase pooler / Neon / PgBouncer)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/msviz?schema=public
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=msviz-images
FRONTEND_URL=http://localhost:5173
# Comma-separated production origins (Cloudflare Pages URL, custom domain)
ALLOWED_ORIGINS=https://your-site.pages.dev,https://www.yourdomain.com
ADMIN_EMAIL=admin@msviz.com
ADMIN_PASSWORD=Admin@MSVIZ2026
ADMIN_NAME=MSVIZ Admin
MAX_FILE_SIZE_MB=10
