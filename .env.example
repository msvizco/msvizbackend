PORT=5000
NODE_ENV=development
# Pooled connection (port 6543) — use for app runtime / Vercel DATABASE_URL
DATABASE_URL=postgresql://USER:PASSWORD@host:6543/postgres?pgbouncer=true&connection_limit=5
# Direct connection (port 5432) — use for Prisma migrations only
DIRECT_URL=postgresql://USER:PASSWORD@host:5432/postgres?sslmode=require
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=msviz-images
FRONTEND_URL=http://localhost:5173
# Comma-separated production origins (Cloudflare Pages URL, custom domain)
ALLOWED_ORIGINS=https://your-site.pages.dev,https://www.yourdomain.com
ADMIN_EMAIL=admin@msviz.com
ADMIN_PASSWORD=Admin@MSVIZ2026
ADMIN_NAME=MSVIZ Admin
MAX_FILE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=100
