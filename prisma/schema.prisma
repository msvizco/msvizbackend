generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id               String         @id @default(uuid())
  title            String
  slug             String         @unique
  shortDescription String
  description      String         @db.Text
  category         String
  location         String
  year             Int
  status           String         @default("concept")
  client           String?
  architect        String?
  projectArea      String?
  coverImage       String?
  coverImagePath   String?
  featured         Boolean        @default(false)
  latest           Boolean        @default(false)
  completed        Boolean        @default(false)
  displayOrder     Int            @default(0)
  published        Boolean        @default(false)
  images           ProjectImage[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([slug])
  @@index([category])
  @@index([status])
  @@index([published])
  @@index([featured])
  @@index([latest])
  @@index([completed])
  @@index([year])
}

model ProjectImage {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  imageUrl     String
  storagePath  String
  altText      String?
  caption      String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([projectId])
}

model Service {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  shortDescription String
  fullDescription  String   @db.Text
  imageUrl         String?
  storagePath      String?
  icon             String?
  displayOrder     Int      @default(0)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([slug])
  @@index([active])
  @@index([displayOrder])
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  service   String?
  message   String   @db.Text
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model SiteSetting {
  id                 String   @id @default("default")
  companyName        String
  logoUrl            String?
  logoPath           String?
  email              String
  phone              String
  whatsapp           String?
  address            String
  facebook           String?
  instagram          String?
  linkedin           String?
  youtube            String?
  websiteDescription String   @db.Text
  heroHeading        String
  heroSubtitle       String
  aboutIntro         String?  @db.Text
  vision             String?  @db.Text
  mission            String?  @db.Text
  philosophy         String?  @db.Text
  differentiators    String?  @db.Text
  yearsExperience    Int      @default(0)
  projectsCompleted  Int      @default(0)
  clientsServed      Int      @default(0)
  awardsWon          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(uuid())
  name      String
  role      String?
  company   String?
  quote     String   @db.Text
  imageUrl  String?
  rating    Int      @default(5)
  featured  Boolean  @default(true)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Faq {
  id           String   @id @default(uuid())
  question     String
  answer       String   @db.Text
  displayOrder Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
